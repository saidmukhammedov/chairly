# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:12345678@127.0.0.1:5432/chairly_db?schema=public"

# Authentication
JWT_SECRET="chairly_super_secure_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Default Shop Config
DEFAULT_TIMEZONE="Asia/Tashkent"
DEFAULT_CURRENCY="UZS"
