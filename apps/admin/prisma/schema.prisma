datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum UserRole {
  CUSTOMER
  BARBER
  MANAGER
  OWNER
}

enum ShopMemberRole {
  BARBER
  MANAGER
  OWNER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         UserRole     @default(CUSTOMER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  ShopMember[]
  appointments Appointment[] @relation("CustomerAppointments")
  favorites    Favorite[]
  barberProfile BarberProfile?
  auditLogs    AppointmentStatusHistory[]

  @@index([email])
}

model Shop {
  id                  String             @id @default(uuid())
  name                String
  slug                String             @unique
  description         String
  phone               String
  address             String
  city                String
  logoUrl             String?
  coverImageUrl       String?
  timezone            String             @default("Asia/Tashkent")
  currency            String             @default("UZS")
  leadTimeMinutes     Int                @default(30)
  horizonDays         Int                @default(30)
  cancelDeadlineHours Int                @default(2)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  members             ShopMember[]
  barbers             BarberProfile[]
  services            Service[]
  workingHours        ShopWorkingHour[]
  appointments        Appointment[]
  favorites           Favorite[]

  @@index([slug])
  @@index([city])
}

model ShopMember {
  id        String         @id @default(uuid())
  shopId    String
  userId    String
  role      ShopMemberRole
  createdAt DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

model BarberProfile {
  id        String   @id @default(uuid())
  shopId    String
  userId    String?  @unique
  name      String
  bio       String?
  avatarUrl String?
  specialty String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     BarberService[]
  schedules    BarberSchedule[]
  breaks       BarberBreak[]
  blockedTimes BarberBlockedTime[]
  appointments Appointment[]

  @@index([shopId])
}

model Service {
  id              String   @id @default(uuid())
  shopId          String
  name            String
  description     String?
  category        String   @default("Haircut")
  price           Int      // In smallest currency denomination or integer UZS
  durationMinutes Int
  bufferMinutes   Int      @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barbers      BarberService[]
  appointments Appointment[]

  @@index([shopId])
}

model BarberService {
  barberId  String
  serviceId String

  barber  BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([barberId])
  @@index([serviceId])
}

model ShopWorkingHour {
  id        String  @id @default(uuid())
  shopId    String
  dayOfWeek Int     // 0=Sunday, 1=Monday ... 6=Saturday
  openTime  String  // "09:00"
  closeTime String  // "21:00"
  isClosed  Boolean @default(false)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
  @@index([shopId])
}

model BarberSchedule {
  id        String  @id @default(uuid())
  barberId  String
  dayOfWeek Int     // 0=Sunday, 1=Monday ... 6=Saturday
  startTime String  // "09:00"
  endTime   String  // "19:00"
  isWorking Boolean @default(true)

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model BarberBreak {
  id        String  @id @default(uuid())
  barberId  String
  dayOfWeek Int
  startTime String  // "13:00"
  endTime   String  // "14:00"
  title     String? @default("Lunch Break")

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
}

model BarberBlockedTime {
  id        String   @id @default(uuid())
  barberId  String
  startTime DateTime
  endTime   DateTime
  reason    String?

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startTime, endTime])
}

model Appointment {
  id                 String            @id @default(uuid())
  bookingReference   String            @unique
  shopId             String
  barberId           String
  customerId         String
  serviceId          String

  // Historical Snapshot preserved at time of booking
  serviceName        String
  servicePrice       Int
  serviceDuration    Int
  bufferMinutes      Int               @default(5)
  currency           String            @default("UZS")

  status             AppointmentStatus @default(CONFIRMED)
  startTime          DateTime
  endTime            DateTime
  bufferEndTime      DateTime          // endTime + bufferMinutes

  notes              String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  shop          Shop                       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  barber        BarberProfile              @relation(fields: [barberId], references: [id], onDelete: Restrict)
  customer      User                       @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Restrict)
  service       Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  statusHistory AppointmentStatusHistory[]

  @@index([shopId, startTime])
  @@index([barberId, startTime, bufferEndTime])
  @@index([customerId, startTime])
  @@index([status])
}

model AppointmentStatusHistory {
  id             String            @id @default(uuid())
  appointmentId  String
  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus
  changedById    String?
  reason         String?
  createdAt      DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
}
